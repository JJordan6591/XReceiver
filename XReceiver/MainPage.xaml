<Page
    x:Class="XReceiver.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XReceiver"
    xmlns:automation="using:Windows.UI.Xaml.Automation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="Black"
    Loaded="OnLoaded">

    <Page.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E0202020" />
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#E6181818" />
        <SolidColorBrush x:Key="StatusPillBackgroundBrush" Color="#CC1E1E1E" />
        <SolidColorBrush x:Key="DiagnosticsBackgroundBrush" Color="#B0000000" />
        <SolidColorBrush x:Key="HelperTextBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="BodyTextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="StatusStoppedBrush" Color="#808080" />
        <SolidColorBrush x:Key="StatusWaitingBrush" Color="#FFC107" />
        <SolidColorBrush x:Key="StatusReceivingBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="StatusReconnectingBrush" Color="#FF9800" />
        <SolidColorBrush x:Key="StatusErrorBrush" Color="#F44336" />

        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="PrimaryPanelButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="160" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HelperTextBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="StatusPrimaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusSecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource HelperTextBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
    </Page.Resources>

    <Grid Background="Black">
        <MediaPlayerElement x:Name="VideoElement"
                            AreTransportControlsEnabled="False"
                            Stretch="Uniform"
                            IsTabStop="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

        <!-- TV-safe area: overlays stay inside 48,27 effective pixels of the edge. -->
        <Grid x:Name="SafeOverlayRoot" Margin="48,27,48,27">
            <Border x:Name="StatusPill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource StatusPillBackgroundBrush}"
                    CornerRadius="16"
                    Padding="14,8,18,8"
                    IsHitTestVisible="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,0,10,0" Fill="{StaticResource StatusStoppedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Stopped" Style="{StaticResource StatusPrimaryText}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusDetailText" Style="{StaticResource StatusSecondaryText}" Margin="22,4,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="WaitingGuide" Style="{StaticResource StatusSecondaryText}" Margin="22,8,0,0" Visibility="Collapsed"
                               Text="The sender and this Xbox must be on the same local network." />
                </StackPanel>
            </Border>

            <Border x:Name="DiagnosticsPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource DiagnosticsBackgroundBrush}"
                    CornerRadius="6"
                    Padding="14,10,14,10"
                    MaxWidth="620"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="720">
                    <TextBlock x:Name="DiagnosticsText" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource BodyTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                </ScrollViewer>
            </Border>

            <Border x:Name="FirstRunPanel"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#CC000000"
                    Visibility="Collapsed"
                    XYFocusKeyboardNavigation="Enabled">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource OverlayBackgroundBrush}"
                        CornerRadius="10"
                        Padding="28"
                        MaxWidth="920"
                        MaxHeight="720">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="FirstRunTitle" Text="XReceiver" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,10"
                                       Text="Put this Xbox and the UxPlay computer on the same local network. Video is UDP 5000. Audio is UDP 5002." />
                            <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,10"
                                       Text="On the Apple device, choose this receiver from Screen Mirroring. UxPlay is a separate project and is not included here." />
                            <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,10"
                                       Text="Menu opens controls. View toggles diagnostics. B hides panels and never stops playback." />
                            <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,16"
                                       Text="Choose Video only in Playback overlay for an unobstructed picture. This app receives H.264, up to 1080p60, even on a 4K display." />
                            <Button x:Name="FirstRunContinueButton"
                                    Content="Continue"
                                    Style="{StaticResource PrimaryPanelButton}"
                                    HorizontalAlignment="Left"
                                    Click="OnFirstRunContinueClick"
                                    automation:AutomationProperties.Name="Continue"
                                    automation:AutomationProperties.HelpText="Dismisses this welcome screen. You can reopen these instructions from the control panel." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <Border x:Name="ControlPanel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource PanelBackgroundBrush}"
                    CornerRadius="8"
                    Padding="18"
                    XYFocusKeyboardNavigation="Enabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="StartButton" Content="Start" Style="{StaticResource PanelButton}" Click="OnStartClick"
                                automation:AutomationProperties.Name="Start receiver"
                                automation:AutomationProperties.HelpText="Begins listening for video and audio on the configured UDP ports." />
                        <Button x:Name="StopButton" Content="Stop" Style="{StaticResource PanelButton}" Click="OnStopClick"
                                automation:AutomationProperties.Name="Stop receiver"
                                automation:AutomationProperties.HelpText="Stops listening and releases network listeners." />
                        <Button x:Name="DiagnosticsButton" Content="View" Style="{StaticResource PanelButton}" Click="OnDiagnosticsClick"
                                automation:AutomationProperties.Name="Toggle diagnostics"
                                automation:AutomationProperties.HelpText="Shows or hides the technical diagnostics overlay." />
                        <Button x:Name="HelpButton" Content="Setup help" Style="{StaticResource PanelButton}" Click="OnHelpClick"
                                automation:AutomationProperties.Name="Setup help"
                                automation:AutomationProperties.HelpText="Reopens the welcome instructions." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Video port" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="VideoPortBox" Width="110" Margin="0,0,24,0" InputScope="Number" MaxLength="5" LostFocus="OnPortLostFocus"
                                 automation:AutomationProperties.Name="Video port"
                                 automation:AutomationProperties.HelpText="UDP port for incoming video. Default 5000. Valid range 1024 to 65535." />
                        <TextBlock Text="Audio port" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="AudioPortBox" Width="110" InputScope="Number" MaxLength="5" LostFocus="OnPortLostFocus"
                                 automation:AutomationProperties.Name="Audio port"
                                 automation:AutomationProperties.HelpText="UDP port for incoming audio. Default 5002. Must differ from the video port." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ToggleSwitch x:Name="AudioToggle" Header="Audio" OnContent="On" OffContent="Off" Margin="0,0,16,0" MinWidth="120" Toggled="OnAudioToggled"
                                      automation:AutomationProperties.Name="Audio"
                                      automation:AutomationProperties.HelpText="Enables or disables audio playback." />
                        <ToggleSwitch x:Name="TolerantToggle" Header="Loss recovery" OnContent="Tolerant" OffContent="Strict" Margin="0,0,16,0" MinWidth="150" Toggled="OnTolerantToggled"
                                      automation:AutomationProperties.Name="Loss recovery"
                                      automation:AutomationProperties.HelpText="Strict waits for a clean keyframe after loss. Tolerant may show brief artifacts while recovering." />
                        <ToggleSwitch x:Name="AutoStartToggle" Header="Auto-start" OnContent="On" OffContent="Off" MinWidth="120" Toggled="OnAutoStartToggled"
                                      automation:AutomationProperties.Name="Auto-start"
                                      automation:AutomationProperties.HelpText="Starts the receiver automatically when the app launches." />
                    </StackPanel>

                    <TextBlock Text="Playback overlay" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="OverlayAutomaticButton" Content="Automatic" Style="{StaticResource PanelButton}" Click="OnOverlayAutomaticClick"
                                automation:AutomationProperties.Name="Automatic overlay"
                                automation:AutomationProperties.HelpText="Shows status briefly, then hides it during playback." />
                        <Button x:Name="OverlayAlwaysButton" Content="Always visible" Style="{StaticResource PanelButton}" Click="OnOverlayAlwaysClick"
                                automation:AutomationProperties.Name="Always visible overlay"
                                automation:AutomationProperties.HelpText="Keeps the compact status visible while receiving." />
                        <Button x:Name="OverlayVideoOnlyButton" Content="Video only" Style="{StaticResource PanelButton}" Click="OnOverlayVideoOnlyClick"
                                automation:AutomationProperties.Name="Video only overlay"
                                automation:AutomationProperties.HelpText="Hides all chrome while healthy video is playing. Menu and View can open panels temporarily." />
                    </StackPanel>
                    <TextBlock x:Name="OverlayModeText" Style="{StaticResource HelperText}" Margin="0,0,0,12" Text="Automatic" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="A/V offset" Style="{StaticResource LabelText}" />
                        <Button x:Name="AvMinusButton" Content="-10 ms" Style="{StaticResource PanelButton}" MinWidth="90" Click="OnAvMinusClick"
                                automation:AutomationProperties.Name="Decrease A/V offset"
                                automation:AutomationProperties.HelpText="Moves audio earlier relative to video by 10 milliseconds." />
                        <TextBlock x:Name="AvOffsetText" Text="0 ms" VerticalAlignment="Center" MinWidth="70" Margin="0,0,12,0"
                                   Foreground="{StaticResource BodyTextBrush}" FontSize="16" />
                        <Button x:Name="AvPlusButton" Content="+10 ms" Style="{StaticResource PanelButton}" MinWidth="90" Click="OnAvPlusClick"
                                automation:AutomationProperties.Name="Increase A/V offset"
                                automation:AutomationProperties.HelpText="Moves audio later relative to video by 10 milliseconds." />
                    </StackPanel>

                    <StackPanel x:Name="DebugToolsPanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                        <Button x:Name="SelfTestButton" Content="Self-test" Style="{StaticResource PanelButton}" Click="OnSelfTestClick" />
                        <Button x:Name="PocSocketsButton" Content="PoC: sockets" Style="{StaticResource PanelButton}" Click="OnPocSocketsClick" />
                        <Button x:Name="PocClipButton" Content="PoC: clip" Style="{StaticResource PanelButton}" Click="OnPocClipClick" />
                        <Button x:Name="PocToneButton" Content="PoC: tone" Style="{StaticResource PanelButton}" Click="OnPocToneClick" />
                    </StackPanel>

                    <TextBlock Text="Menu: show or hide panel    View: diagnostics    B: hide panel"
                               Style="{StaticResource HelperText}" FontSize="13" Opacity="0.85" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
